@model MachineTrace.Application.Commands.Machine.Edit.MachineEditCommand

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>EditCommand</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Code" class="control-label"></label>
                <input asp-for="Code" class="form-control" />
                <span asp-validation-for="Code" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Mth" class="control-label"></label>
                <input asp-for="Mth" class="form-control" />
                <span asp-validation-for="Mth" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ServiceInterval" class="control-label"></label>
                <input asp-for="ServiceInterval" class="form-control" />
                <span asp-validation-for="ServiceInterval" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label asp-for="Condition" class="control-label"></label>
                <select asp-for="Condition" asp-items="@(new SelectList(Model.AvailableConditions))" class="form-control"></select>
                <span asp-validation-for="Condition" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" asp-items="@(new SelectList(Model.AvailableStatuses))" class="form-control"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="CategoryId" class="control-label"></label>
                <select asp-for="CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))" class="form-control"></select>
                <span asp-validation-for="CategoryId" class="text-danger"></span>
            </div>
            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a class="btn btn-primary" asp-action="Details" asp-route-id="@Model.Id">Back to details</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
