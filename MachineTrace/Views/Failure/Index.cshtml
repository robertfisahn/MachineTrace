@model IEnumerable<MachineTrace.Application.Dto.Failure.FailureDto>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Mth)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Priority)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CreatedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MachineCode)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Mth)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Priority)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.CreatedDate)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.MachineCode)
            </td>
            <td>
                <a class="btn btn-primary" asp-area="" asp-controller="Failure" asp-action="Edit" asp-route-id="@item.Id">Edit</a>
                <a class="btn btn-secondary" asp-area="" asp-controller="Failure" asp-action="Details" asp-route-id="@item.Id">Details</a>
                <a class="btn btn-danger" asp-area="" asp-controller="Failure" asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
