@model MachineTrace.Application.Commands.DailyReport.Edit.DailyReportEditCommand

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>DailyReportEditCommand</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit">
            <input type="hidden" asp-for="Id" />
            <div class="form-group">
                <label asp-for="Mth" class="control-label"></label>
                <input asp-for="Mth" class="form-control" />
                <span asp-validation-for="Mth" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Status" class="control-label"></label>
                <select asp-for="Status" asp-items="@(new SelectList(Model.MaintenanceStatuses))" class="form-control"></select>
                <span asp-validation-for="Status" class="text-danger"></span>
            </div>
            <input type="hidden" asp-for="MachineId" />
            <div class="form-group mt-3">
                <input type="submit" value="Save" class="btn btn-primary" />
                <a class="btn btn-primary" asp-action="Index">Back to List</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
