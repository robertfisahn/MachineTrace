@model MachineTrace.Application.Dto.DailyReport.DailyReportDtoDetails

@{
    ViewData["Title"] = "Details";
}

<h1>Details</h1>

<div>
    <h4>DailyReportDtoDetails</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Mth)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Mth)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Status)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.CreatedDate)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.CreatedDate)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.MachineCode)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.MachineCode)
        </dd>
    </dl>
</div>
<div>
    <a class="btn btn-primary" asp-action="Edit" asp-controller="DailyReport" asp-route-id="@Model.Id">Edit</a>
    @if (Model.FromMachine != null)
    {
        <a class="btn btn-primary" asp-controller="DailyReport" asp-action="ByMachine" asp-route-machineId="@Model.MachineId">Back to Machine</a>
    }
    else
    {
        <a class="btn btn-primary" asp-controller="DailyReport" asp-action="Index">Back to Failures</a>
    }
</div>
